class Solution {
    public boolean isPalindrome(String s) {
        int length = s.length();
        String S ="";
        s = s.toLowerCase();
        for(int i = 0;i<length;i++){
            if((s.charAt(i)>='a'&&s.charAt(i)<='z') || (s.charAt(i)>='0'&&s.charAt(i)<='9'))
            S = S+s.charAt(i);
        }
        int L = S.length();
        String S1 = "";
        while(L>0){
        S1 = S1+S.charAt(L-1);
        L--;
        }
        return S.equals(S1);
        
    }
}
