class Solution {
    public int[] plusOne(int[] digits) {
        int length = digits.length;
        if(length>=1 && length<=100 && digits[0]>=0 && digits[0]<=9){
            if(digits[length-1]==9)
            {
                for(int i = length-1;i>=0;i--){
                    if(digits[i]==9)
                        digits[i]=0;
                    else{
                        digits[i]+=1;
                        return digits;
                    }
                }
                int[] arr = new int[length+1];
                arr[0] = 1;
                return arr;
            }
            else{
                digits[length-1]+=1;
                return digits;
            }
        }
        return digits;
    }
}
