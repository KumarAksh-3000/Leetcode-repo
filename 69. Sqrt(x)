class Solution {
    public int mySqrt(int x) {
     if(x<2) return x;
     int ans=0,mid=0;
     int left=1,right = x/2;
     while(left<=right){
        mid = (left+right)/2;
        if((long)mid*mid<=x){
            ans = mid;
            left = mid+1;
        }
        else
        right = mid-1;
     }
     return ans;
    }
}
