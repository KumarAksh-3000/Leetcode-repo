class Solution {
    public int reverse(int x) {
        int num1=0;
        String s = Integer.toString(x);
        int l = 0,r=0;
        if(x>=0)
        l = s.length();
        else
        l = s.length()-1;
        for(int i = 1;i<=l;i++){
            r = x%10;
            if (num1 > Integer.MAX_VALUE/10 || (num1 == Integer.MAX_VALUE/10 && r > 7)) return 0;
            if (num1 < Integer.MIN_VALUE/10 || (num1 == Integer.MIN_VALUE/10 && r < -8)) return 0; 
            num1 = num1*10+r;
            x/=10;
        }
        return num1;
     }
}
